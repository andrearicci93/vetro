    <Compile Include="../src/Core/GuideReply.cs" />
    <Compile Include="../src/Core/GuideStore.cs" />
    <Compile Include="../src/Core/GuideGrid.cs" />
    <Compile Include="../src/Core/GuideScene.cs" />
    <Compile Include="../src/Core/Takeover.cs" />
    <Compile Include="../src/Core/ClientFolders.cs" />
    <Compile Include="../src/Core/InfoPanel.cs" />
