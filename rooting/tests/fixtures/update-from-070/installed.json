{
 "note": "What the published 0.7.0 has on the TV: sha256 of every file its updater accepts (the files of the signed 0.7.0 bundle, plus payload/net6, which that bundle left out but the package installs and which has not changed since 0.5.0), and the launcher and tuner stop lines it puts in the apply script. Made from tag v0.7.0 (fb83fd0) and the bundle on the updates branch on 2026-11-21; the files never change.",
 "variants": {
  "fb83fd0": {
   "dockStop": "systemctl stop --no-block vetro-dock.service >/dev/null 2>&1; i=0; while [ $i -lt 30 ]; do case \"$(systemctl is-active vetro-dock.service 2>/dev/null)\" in active|activating|deactivating|reloading) sleep 0.1; i=$((i+1)) ;; *) break ;; esac; done; systemctl reset-failed vetro-dock.service >/dev/null 2>&1; p=$(cat /home/owner/tvlauncher.pid 2>/dev/null); if [ -n \"$p\" ] && tr \"\\0\" \" \" < /proc/$p/cmdline 2>/dev/null | grep -q tvlauncher-dotnet.dll; then kill -9 $p; sleep 0.3; fi; rm -f /home/owner/tvlauncher.pid\nsystemctl stop --no-block vetro-tuner.service >/dev/null 2>&1; i=0; while [ $i -lt 30 ]; do case \"$(systemctl is-active vetro-tuner.service 2>/dev/null)\" in active|activating|deactivating|reloading) sleep 0.1; i=$((i+1)) ;; *) break ;; esac; done; systemctl reset-failed vetro-tuner.service >/dev/null 2>&1; p=$(cat /home/owner/vetro-tuner.pid 2>/dev/null); if [ -n \"$p\" ] && tr \"\\0\" \" \" < /proc/$p/cmdline 2>/dev/null | grep -q vetro-tuner.dll; then kill -9 $p; sleep 0.3; fi; rm -f /home/owner/vetro-tuner.pid /tmp/vetro-tuner.ctl",
